# Kopieer naar .env.local voor lokaal testen (npm run dev).
# Gebruik nooit een echte sleutel in GitHub.

# Verplicht: verzending van de formuliermail via Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_TO_EMAIL=info@rinlogistiek.nl
RESEND_FROM_EMAIL=R.I.N. B.V. <noreply@rinlogistiek.nl>

# Optioneel: spambeveiliging op het formulier (Cloudflare Turnstile).
# Zonder deze twee sleutels werkt het formulier gewoon, maar zonder captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x0000000000000000000000
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000000000

# Optioneel: alleen nodig als de site op een ander domein draait.
NEXT_PUBLIC_SITE_URL=https://www.rinlogistiek.nl
